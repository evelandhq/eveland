# Copy this file to .env at the repo root, then run `pnpm dev`. Every
# uncommented value below works out of the box for local development.
# Never reuse an eveland-dev-* placeholder secret outside local development.

# The publicly known eveland-dev-* fallback secrets apply ONLY under an
# explicit NODE_ENV=development. Unset NODE_ENV fails closed like production.
NODE_ENV=development

# --- Database ---
DATABASE_URL=postgres://eveland:eveland@localhost:5432/eveland
# Platform-owned durable workflow BASE URL. The worker derives one database per
# project (eveland_wf_<project>_<digest>) from it, so this role needs CREATEDB.
# Docker Agent containers reach the host's Postgres via host.docker.internal.
WORKFLOW_POSTGRES_URL=postgres://eveland:eveland@host.docker.internal:5432/eveland
# Worker-reachable form of the same database URL (the worker connects through
# localhost rather than the Docker host gateway).
WORKFLOW_POSTGRES_BOOTSTRAP_URL=postgres://eveland:eveland@localhost:5432/eveland

# --- Secrets & admin bootstrap ---
APP_SECRET_KEY=eveland-dev-secret-key-000000000
# At least 32 characters. Production: openssl rand -base64 32
BETTER_AUTH_SECRET=eveland-dev-better-auth-secret-0000
BETTER_AUTH_URL=http://localhost:4000
EVELAND_ADMIN_EMAIL=admin@example.com
# At least 12 characters.
EVELAND_ADMIN_PASSWORD=eveland_password

# --- Build identity ---
# Shown by health endpoints, startup logs, and Settings > About. Admins also
# see the effective allowlisted configuration there. Secret values are
# fixed-mask only, and connection URL credentials/query values are removed.
# Stable installations should use the checked-out release tag's commit SHA;
# instances testing main should use channel=edge and that checkout's commit SHA.
EVELAND_RELEASE_CHANNEL=dev
EVELAND_REVISION=unknown

# Production only when Web and API use sibling hosts, e.g. app.example.com and api.example.com.
# EVELAND_COOKIE_DOMAIN=.example.com

# --- Agent-user Identity ---
# Stable public issuer embedded in short-lived Caller Tokens.
EVELAND_IDENTITY_ISSUER=http://localhost:4000
# Exact browser origins allowed to read Identity Session state, request Caller
# Tokens, and log out. Comma-separated; never use "*".
EVELAND_IDENTITY_ALLOWED_ORIGINS=http://localhost:3010
# JWKS address injected into deployed Agents. Docker Agents reach the host API
# through host.docker.internal; systemd Agents can use 127.0.0.1.
EVELAND_IDENTITY_JWKS_URL=http://host.docker.internal:4000/.well-known/jwks.json

# --- Paths & data ---
EVELAND_DATA_DIR=.eveland-data
# Required only when the worker itself runs in Compose. Docker uses it for
# durable sandbox cache and Agent observability policy bind mounts.
# EVELAND_HOST_DATA_DIR=/absolute/path/to/eveland/.eveland-data

# --- OpenTelemetry Collector ---
# Internal platform bootstrap only. Monitoring/privacy and external
# destinations are stored in System settings, not in environment variables.
EVELAND_OTLP_ENDPOINT=http://127.0.0.1:4318
EVELAND_OTLP_SERVICE_TOKEN=eveland-dev-otlp-service-token
# Comma-separated exact hostnames or IPs allowed to use HTTP and/or resolve to
# private addresses for External Observability Destinations. Empty is safest.
EVELAND_OBSERVABILITY_PRIVATE_ENDPOINT_ALLOWLIST=
EVELAND_OTEL_METRIC_INTERVAL_MS=60000

# --- Gateway ---
EVELAND_AGENT_BASE_DOMAINS=agent.localhost
EVELAND_GATEWAY_INTERNAL_URL=http://127.0.0.1:4080
EVELAND_GATEWAY_SERVICE_TOKEN=eveland-dev-gateway-token
EVELAND_GATEWAY_AFFINITY_SECRET=eveland-dev-affinity-secret
EVELAND_GATEWAY_MAX_REQUEST_BODY_BYTES=10485760
EVELAND_GATEWAY_PUBLIC_SCHEME=http
EVELAND_GATEWAY_PUBLIC_PORT=4080
EVELAND_PLAYGROUND_TIMEOUT_MS=120000

# --- API internal & activation ---
# Gateway uses this private API origin only for service-authenticated runtime activation.
EVELAND_API_INTERNAL_URL=http://127.0.0.1:4000
EVELAND_ACTIVATION_LEASE_TTL_MS=180000
EVELAND_PLAYGROUND_SESSION_IDLE_TTL_MS=86400000
EVELAND_API_SESSION_IDLE_TTL_MS=604800000
EVELAND_COLD_START_TIMEOUT_MS=30000
EVELAND_SOURCE_PREFLIGHT_TTL_MS=3600000
EVELAND_ACTIVATION_RENEW_INTERVAL_MS=60000
EVELAND_SCHEDULER_PREWARM_MS=60000
EVELAND_ACTIVATION_IDLE_TTL_MS=300000
EVELAND_ACTIVATION_REAPER_BATCH_SIZE=25
EVELAND_ACTIVATION_RECOVERY_BATCH_SIZE=25
EVELAND_ACTIVATION_START_STALE_MS=300000
EVELAND_ACTIVATION_RECONCILE_BATCH_SIZE=100
EVELAND_ORPHAN_SWEEP_INTERVAL_MS=3600000
EVELAND_ORPHAN_GRACE_MS=300000

# --- Scheduler ---
# Scheduler Channel service authentication. The two secrets must be
# independent values of at least 32 bytes; outside local development generate
# them with: openssl rand -hex 32
EVELAND_SCHEDULER_RUNTIME_SECRET=eveland-dev-scheduler-runtime-secret
EVELAND_SCHEDULER_DISPATCH_SECRET=eveland-dev-scheduler-dispatch-secret
# API callback the injected Scheduler Channel uses to claim/complete dispatches.
# Docker Agent containers reach the API through the host gateway; a host
# systemd runtime should use http://127.0.0.1:4000 instead.
EVELAND_SCHEDULER_REDEEM_URL=http://host.docker.internal:4000/internal/scheduler/dispatch
EVELAND_SCHEDULER_PLANNER_BATCH_SIZE=25
EVELAND_SCHEDULER_DISPATCH_TIMEOUT_MS=120000
# Hard safety deadline for a dispatched run whose Observer never reports a
# turn boundary. This is independent from the 5-minute activation idle TTL.
EVELAND_SCHEDULE_RUN_MAX_RUNTIME_MS=86400000

# --- Worker & deployments ---
WORKER_POLL_INTERVAL_MS=5000
EVELAND_HOST_METRIC_INTERVAL_MS=60000
EVELAND_GIT_CLONE_TIMEOUT_MS=120000
EVELAND_GIT_CLONE_MAX_ATTEMPTS=3
EVELAND_GIT_CLONE_RETRY_DELAY_MS=1000
WORKER_JOB_HEARTBEAT_INTERVAL_MS=30000
WORKER_JOB_STALE_MS=120000
WORKER_JOB_RECOVERY_BATCH_SIZE=25
# Docker cold starts on dev machines regularly exceed the 15s default.
EVELAND_HEALTH_TIMEOUT_MS=30000
EVELAND_RELEASE_RETENTION=3
EVELAND_RELEASE_SWEEP_INTERVAL_MS=3600000
EVELAND_RELEASE_SWEEP_BATCH_SIZE=25

# --- Web ---
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000
