# Copy this file to .env at the repo root, then run `pnpm dev`. Every
# uncommented value below works out of the box for local development.
# Never reuse an eveland-dev-* placeholder secret outside local development.
#
# This file lists only what an installation must decide: addresses, secrets,
# and identity. Every tuning knob (timeouts, batch sizes, sandbox limits,
# retention, ...) has a code default and is documented in
# docs/en/reference/environment-variables.md (docs/zh/... in Chinese);
# set one in .env only to override it.

# The publicly known eveland-dev-* fallback secrets apply ONLY under an
# explicit NODE_ENV=development. Unset NODE_ENV fails closed like production.
NODE_ENV=development

# --- Public origin ---
# The single browser-visible origin (the front door). Better Auth URL, CORS
# origin, and the Identity issuer derive from it; individual overrides exist
# but are rarely needed (see the reference documentation).
EVELAND_PUBLIC_ORIGIN=http://localhost:17300

# --- Database ---
DATABASE_URL=postgres://eveland:eveland@localhost:17310/eveland

# --- Shared workflow world ---
# Deployment- and host-reachable views of the shared database every new build
# uses. Keep both configured so the dispatcher can start under `pnpm dev`;
# durable wake/continuation needs API, worker, and the dispatcher all running.
EVELAND_WORKFLOW_WORLD_URL=postgres://eveland:eveland@host.docker.internal:17310/eveland
EVELAND_WORKFLOW_WORLD_BOOTSTRAP_URL=postgres://eveland:eveland@localhost:17310/eveland
WORKFLOW_DISPATCHER_ACTIVATION_API_URL=http://localhost:17301
WORKFLOW_DISPATCHER_ACTIVATION_TOKEN=eveland-dev-gateway-token

# --- Secrets & admin bootstrap ---
APP_SECRET_KEY=eveland-dev-secret-key-000000000
# At least 32 characters. Production: openssl rand -base64 32
BETTER_AUTH_SECRET=eveland-dev-better-auth-secret-0000
EVELAND_ADMIN_EMAIL=admin@example.com
# At least 12 characters.
EVELAND_ADMIN_PASSWORD=eveland_password

# --- Agent-user Identity ---
# Exact browser origins allowed to read Identity Session state, request Caller
# Tokens, and log out. Comma-separated; never use "*". No default: leave unset
# until an external chat frontend needs it, e.g.
# EVELAND_IDENTITY_ALLOWED_ORIGINS=http://localhost:3010
EVELAND_IDENTITY_ALLOWED_ORIGINS=

# --- Paths & data ---
EVELAND_DATA_DIR=.eveland-data
# Required only when the worker itself runs in Compose. Docker uses it for
# durable sandbox cache and Agent observability policy bind mounts.
# EVELAND_HOST_DATA_DIR=/absolute/path/to/eveland/.eveland-data

# --- OpenTelemetry Collector ---
# Internal platform bootstrap only. Monitoring/privacy and external
# destinations are stored in System settings, not in environment variables.
EVELAND_OTLP_SERVICE_TOKEN=eveland-dev-otlp-service-token

# --- Gateway ---
EVELAND_GATEWAY_SERVICE_TOKEN=eveland-dev-gateway-token
EVELAND_GATEWAY_AFFINITY_SECRET=eveland-dev-affinity-secret

# --- Scheduler ---
# Scheduler Channel service authentication. The two secrets must be
# independent values of at least 32 bytes; outside local development generate
# them with: openssl rand -hex 32
EVELAND_SCHEDULER_RUNTIME_SECRET=eveland-dev-scheduler-runtime-secret
EVELAND_SCHEDULER_DISPATCH_SECRET=eveland-dev-scheduler-dispatch-secret
# API callback the injected Scheduler Channel uses to claim/complete dispatches.
# Docker Agent containers reach the API through the host gateway; a host
# systemd runtime should use http://127.0.0.1:17301 instead.
EVELAND_SCHEDULER_REDEEM_URL=http://host.docker.internal:17301/internal/scheduler/dispatch

