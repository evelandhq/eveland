DATABASE_URL=postgres://eveland:eveland@localhost:5432/eveland
WORKFLOW_POSTGRES_URL=postgres://eveland:eveland@host.docker.internal:5432/eveland
# Optional worker-reachable form of the same database URL (useful when deployments
# run in Docker but the worker reaches Postgres through localhost or a service DNS name).
WORKFLOW_POSTGRES_BOOTSTRAP_URL=postgres://eveland:eveland@localhost:5432/eveland
APP_SECRET_KEY=eveland-dev-secret-key-000000000
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
EVELAND_ADMIN_EMAIL=admin@example.com
EVELAND_ADMIN_PASSWORD=
# Build identity shown by health endpoints, startup logs, and Settings > About.
# Admins also see the effective allowlisted configuration there. Secret values
# are fixed-mask only, and connection URL credentials/query values are removed.
# Stable installations should use the checked-out release tag's commit SHA;
# instances testing main should use channel=edge and that checkout's commit SHA.
EVELAND_RELEASE_CHANNEL=dev
EVELAND_REVISION=unknown
# Production only when Web and API use sibling hosts, e.g. app.example.com and api.example.com.
# EVELAND_COOKIE_DOMAIN=.example.com
EVELAND_DATA_DIR=.eveland-data
# Required when the worker itself runs in Compose. Docker uses it for observer
# outboxes and durable per-project sandbox cache bind mounts.
EVELAND_HOST_DATA_DIR=/absolute/path/to/eveland/.eveland-data
EVELAND_COLLECTOR_MODE=embedded
EVELAND_OBSERVER_ROOT=.eveland-data/observer
EVELAND_COLLECTOR_MAX_CONCURRENT_SESSIONS=100
EVELAND_COLLECTOR_MAX_BACKLOG_BYTES=1073741824
EVELAND_AGENT_BASE_DOMAINS=agent.localhost
EVELAND_GATEWAY_INTERNAL_URL=http://127.0.0.1:4080
EVELAND_GATEWAY_SERVICE_TOKEN=eveland-dev-gateway-token
EVELAND_GATEWAY_AFFINITY_SECRET=eveland-dev-affinity-secret
EVELAND_GATEWAY_MAX_REQUEST_BODY_BYTES=10485760
EVELAND_GATEWAY_PUBLIC_SCHEME=http
EVELAND_GATEWAY_PUBLIC_PORT=4080
# Gateway uses this private API origin only for service-authenticated runtime activation.
EVELAND_API_INTERNAL_URL=http://127.0.0.1:4000
EVELAND_ACTIVATION_LEASE_TTL_MS=180000
EVELAND_COLD_START_TIMEOUT_MS=30000
EVELAND_ACTIVATION_RENEW_INTERVAL_MS=60000
# Scheduler Channel service authentication. Use independent random values of at
# least 32 bytes outside local development. Docker Agent containers reach the
# API through the host gateway; a host systemd runtime should use 127.0.0.1.
EVELAND_SCHEDULER_RUNTIME_SECRET=
EVELAND_SCHEDULER_DISPATCH_SECRET=
EVELAND_SCHEDULER_REDEEM_URL=http://host.docker.internal:4000/internal/scheduler/dispatch
EVELAND_SCHEDULER_PLANNER_BATCH_SIZE=25
EVELAND_SCHEDULER_DISPATCH_TIMEOUT_MS=120000
EVELAND_ACTIVATION_IDLE_TTL_MS=300000
EVELAND_ACTIVATION_REAPER_BATCH_SIZE=25
EVELAND_ACTIVATION_RECOVERY_BATCH_SIZE=25
EVELAND_ACTIVATION_START_STALE_MS=300000
EVELAND_ACTIVATION_RECONCILE_BATCH_SIZE=100
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000
WORKER_POLL_INTERVAL_MS=5000
EVELAND_RELEASE_RETENTION=3
