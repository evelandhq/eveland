DATABASE_URL=postgres://eveland:eveland@localhost:5432/eveland
WORKFLOW_POSTGRES_URL=postgres://eveland:eveland@host.docker.internal:5432/eveland
APP_SECRET_KEY=eveland-dev-secret-key-000000000
EVELAND_DATA_DIR=.eveland-data
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000
WORKER_POLL_INTERVAL_MS=5000

# Agent gateway URL settings. lvh.me resolves to localhost and supports
# slug.lvh.me agent hosts during local development.
EVELAND_AGENT_DOMAIN=lvh.me
EVELAND_AGENT_URL_SCHEME=http
EVELAND_AGENT_URL_PORT=8080
