{
  "name": "eveland",
  "version": "0.4.1",
  "homepage": "https://eveland.ai",
  "bugs": "https://github.com/evelandhq/eveland/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evelandhq/eveland.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=2 --testTimeout=30000",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "eve": "0.47.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "eve": ">=0.45.0 <1.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
