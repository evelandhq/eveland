{
  "name": "@eveland/workflow-world",
  "version": "0.1.0",
  "description": "Natively multi-tenant Workflow World for the Eveland platform — orchestration is shared, execution stays in each deployment",
  "license": "Apache-2.0",
  "bin": {
    "eveland-workflow-world-setup": "./bin/setup.js"
  },
  "files": [
    "dist",
    "bin",
    "migrations",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/drizzle/schema.ts",
    "./migrate": "./src/migrate.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./schema": {
        "types": "./dist/drizzle/schema.d.ts",
        "import": "./dist/drizzle/schema.js"
      },
      "./migrate": {
        "types": "./dist/migrate.d.ts",
        "import": "./dist/migrate.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@workflow/errors": "5.0.0-beta.10",
    "@workflow/utils": "5.0.0-beta.6",
    "@workflow/world": "5.0.0-beta.19",
    "@workflow/world-local": "5.0.0-beta.27",
    "cbor-x": "1.6.0",
    "drizzle-orm": "0.45.2",
    "graphile-worker": "0.16.6",
    "pg": "8.20.0",
    "ulid": "~3.0.1",
    "zod": "~4.3.6"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
