{
  "name": "eveland",
  "version": "0.21.0",
  "homepage": "https://eveland.ai",
  "bugs": "https://github.com/evelandhq/eveland/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evelandhq/eveland.git",
    "directory": "packages/eveland"
  },
  "bin": {
    "eveland": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./model-gateway": {
      "types": "./dist/model-gateway.d.ts",
      "import": "./dist/model-gateway.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=2 --testTimeout=30000",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.111",
    "@ai-sdk/openai-compatible": "3.0.82",
    "@ai-sdk/provider": "4.0.35"
  },
  "devDependencies": {
    "eve": "1.0.0-rc.1",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "eve": ">=0.83.0 <1.0.0 || >=1.0.0-0 <2.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
