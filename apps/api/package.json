{
  "name": "@eveland/api",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include ../../.env --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "db:generate": "pnpm --filter @eveland/db db:generate",
    "db:migrate": "pnpm --filter @eveland/db db:migrate",
    "db:push": "pnpm --filter @eveland/db db:push",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=2 --testTimeout=30000"
  },
  "dependencies": {
    "@eveland/agent-auth": "workspace:*",
    "@eveland/core": "workspace:*",
    "@eveland/db": "workspace:*",
    "@eveland/identity-broker": "workspace:*",
    "@eveland/platform-observability": "workspace:*",
    "@eveland/session-collector": "workspace:*",
    "@hono/node-server": "^2.0.6",
    "better-auth": "^1.6.23",
    "hono": "^4.12.27",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vitest": "^4.1.9"
  }
}
