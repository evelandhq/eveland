{
  "name": "@eveland/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./db/client": "./src/db/client.ts",
    "./db/schema": "./src/db/schema.ts",
    "./store": "./src/store.ts",
    "./store-factory": "./src/store-factory.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eveland/shared": "workspace:*",
    "@hono/node-server": "^2.0.6",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.9"
  }
}
