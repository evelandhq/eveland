{
  "name": "@evelandhq/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import=@evelandhq/platform-observability/register --include ../../.env --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "db:generate": "pnpm --filter @evelandhq/db db:generate",
    "db:migrate": "pnpm --filter @evelandhq/db db:migrate",
    "db:push": "pnpm --filter @evelandhq/db db:push",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=2 --testTimeout=30000"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.7.2",
    "@evelandhq/agent-auth": "workspace:*",
    "@evelandhq/core": "workspace:*",
    "@evelandhq/db": "workspace:*",
    "@evelandhq/identity-broker": "workspace:*",
    "@evelandhq/platform-observability": "workspace:*",
    "@evelandhq/session-collector": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "better-auth": "^1.7.2",
    "hono": "^4.13.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "protobufjs": "^8.7.2",
    "vitest": "^4.1.11"
  }
}
