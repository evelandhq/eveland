{
  "name": "@eveland/worker",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include ../../.env --env-file=../../.env src/worker.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=2 --testTimeout=30000",
    "smoke:connections": "tsx src/integration/connections-e2e.ts",
    "smoke:docker-sandbox": "tsx src/integration/docker-sandbox-smoke.ts"
  },
  "dependencies": {
    "@eveland/agent-observer": "workspace:*",
    "@eveland/agent-scheduler": "workspace:*",
    "@eveland/core": "workspace:*",
    "@eveland/db": "workspace:*",
    "@eveland/platform-observability": "workspace:*",
    "@eveland/sandbox-bwrap": "workspace:*",
    "@eveland/workflow-world": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@workflow/world-postgres": "5.0.0-beta.25",
    "execa": "^9.6.1",
    "pg": "8.20.0",
    "postgres": "^3.4.9",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/pg": "^8.11.10",
    "vitest": "^4.1.9"
  }
}
