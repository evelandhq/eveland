{
  "name": "@evelandhq/worker",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include ../../.env --env-file=../../.env src/worker.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=2 --testTimeout=30000",
    "smoke:connections": "tsx src/integration/connections-e2e.ts",
    "smoke:docker-sandbox": "tsx src/integration/docker-sandbox-smoke.ts",
    "smoke:model-gateway": "tsx src/integration/model-gateway-eve-e2e.ts"
  },
  "dependencies": {
    "@evelandhq/agent-observer": "workspace:*",
    "@evelandhq/agent-scheduler": "workspace:*",
    "@evelandhq/core": "workspace:*",
    "@evelandhq/db": "workspace:*",
    "@evelandhq/platform-observability": "workspace:*",
    "@evelandhq/sandbox-bwrap": "^1.0.0",
    "@evelandhq/workflow-world": "^2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "esbuild": "^0.28.2",
    "eveland": "workspace:*",
    "execa": "^10.0.1",
    "pg": "8.20.0",
    "postgres": "^3.4.9",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/pg": "^8.23.1",
    "vitest": "^5.0.3"
  }
}
