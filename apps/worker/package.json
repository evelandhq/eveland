{
  "name": "@evelandhq/worker",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include ../../.env --env-file=../../.env src/worker.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=2 --testTimeout=30000",
    "smoke:connections": "tsx src/integration/connections-e2e.ts",
    "smoke:docker-sandbox": "tsx src/integration/docker-sandbox-smoke.ts",
    "smoke:workflow-wake": "tsx src/integration/workflow-wake-e2e.ts",
    "smoke:workflow-dual-release": "tsx src/integration/workflow-dual-release-e2e.ts",
    "cutover": "tsx src/cutover/cli.ts"
  },
  "dependencies": {
    "@evelandhq/agent-observer": "workspace:*",
    "@evelandhq/agent-scheduler": "workspace:*",
    "@evelandhq/core": "workspace:*",
    "@evelandhq/db": "workspace:*",
    "@evelandhq/platform-observability": "workspace:*",
    "@evelandhq/sandbox-bwrap": "^0.2.0",
    "@evelandhq/workflow-world": "^0.12.0",
    "@opentelemetry/api": "^1.9.1",
    "@workflow/world-postgres": "5.0.0-beta.34",
    "esbuild": "^0.28.1",
    "execa": "^9.6.1",
    "graphile-worker": "0.16.6",
    "pg": "8.20.0",
    "postgres": "^3.4.9",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/pg": "^8.11.10",
    "vitest": "^4.1.9"
  }
}
