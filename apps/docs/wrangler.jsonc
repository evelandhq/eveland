{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eveland-docs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "routes": [
    {
      "pattern": "eveland.ai",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
}
