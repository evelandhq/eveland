# Explicit here for clarity, though redundant with NODE_ENV=production below: since
# the systemd default flip, a production worker (NODE_ENV=production) resolves to
# systemd on its own when EVELAND_RUNTIME is unset. Keep it set explicitly anyway so
# this file documents the host's runtime unambiguously regardless of NODE_ENV.
EVELAND_RUNTIME=systemd
NODE_ENV=production
EVELAND_RELEASE_CHANNEL=stable
EVELAND_REVISION=unknown
EVELAND_DATA_DIR=/var/lib/eveland
EVELAND_OTLP_ENDPOINT=http://127.0.0.1:4318
EVELAND_OTLP_SERVICE_TOKEN=change-me-to-the-collector-platform-receiver-secret
EVELAND_OTEL_METRIC_INTERVAL_MS=60000
# Must match the API's value: the Worker probes destination health directly, so a
# private destination allowlisted only for the API would always read degraded.
EVELAND_OBSERVABILITY_PRIVATE_ENDPOINT_ALLOWLIST=
# After preflight, Worker publishes only an already-masked configuration snapshot
# at /var/lib/eveland/diagnostics/worker-configuration.json for the admin About page.
# Native systemd Worker and the Compose services share this platform data root.
# EVELAND_HOST_DATA_DIR is intentionally unnecessary here.
DATABASE_URL=postgres://eveland:eveland@127.0.0.1:5432/eveland
WORKFLOW_POSTGRES_URL=postgres://eveland:eveland@127.0.0.1:5432/eveland
# Configure these when rolling projects onto @evelandhq/workflow-world. The
# worker applies all pending migrations before its first retention sweep. Concurrent
# startup and tenant provisioning are serialized by the migration advisory lock.
#EVELAND_WORKFLOW_WORLD_URL=postgres://eveland:eveland@127.0.0.1:5432/eveland_workflow
#EVELAND_WORKFLOW_WORLD_BOOTSTRAP_URL=postgres://eveland:eveland@127.0.0.1:5432/eveland_workflow
#EVELAND_WORKFLOW_WORLD_ROLLOUT=off
# Keep this same value in eveland-workflow-dispatcher.env. "off" is an emergency
# compatibility switch; shared-world readers always support mixed formats.
#EVELAND_WORKFLOW_STREAM_COMPACTION=on
# Must match the API's APP_SECRET_KEY (32 bytes). After rotation, redeploy all
# Agents so their telemetry credential is signed by the new key.
APP_SECRET_KEY=change-me-to-a-32-byte-secret-00
EVELAND_AGENT_BASE_DOMAINS=agents.example.com
EVELAND_GATEWAY_INTERNAL_URL=http://127.0.0.1:4080
EVELAND_GATEWAY_SERVICE_TOKEN=change-me-to-a-long-random-gateway-secret
# Stable public issuer in Caller Token claims; JWKS can use host loopback because
# systemd Agent processes run on this host.
EVELAND_IDENTITY_ISSUER=https://api.example.com
EVELAND_IDENTITY_JWKS_URL=http://127.0.0.1:4000/.well-known/jwks.json
EVELAND_SCHEDULER_RUNTIME_SECRET=change-me-to-an-independent-random-runtime-secret
EVELAND_SCHEDULER_DISPATCH_SECRET=change-me-to-an-independent-random-dispatch-secret
EVELAND_SCHEDULER_REDEEM_URL=http://127.0.0.1:4000/internal/scheduler/dispatch
EVELAND_SCHEDULER_PLANNER_BATCH_SIZE=25
EVELAND_SCHEDULER_DISPATCH_TIMEOUT_MS=120000
EVELAND_SCHEDULER_PREWARM_MS=60000
EVELAND_ACTIVATION_IDLE_TTL_MS=300000
EVELAND_ACTIVATION_REAPER_BATCH_SIZE=25
EVELAND_ACTIVATION_RECOVERY_BATCH_SIZE=25
EVELAND_ACTIVATION_START_STALE_MS=300000
EVELAND_ACTIVATION_RECONCILE_BATCH_SIZE=100
EVELAND_PLAYGROUND_SESSION_IDLE_TTL_MS=86400000
EVELAND_API_SESSION_IDLE_TTL_MS=604800000
# Optional overrides (defaults shown):
#EVELAND_BUILD_USER=eveland-build
#EVELAND_APP_USER=eveland-app
#EVELAND_BUILD_SANDBOX=bwrap
#EVELAND_MEMORY_MAX=2G
#EVELAND_CPU_QUOTA=200%
#EVELAND_TASKS_MAX=512
#EVELAND_SANDBOX_RUN_TIMEOUT_MS=600000
#EVELAND_SANDBOX_MAX_CONCURRENT_PROCESSES=64
#EVELAND_SANDBOX_MAX_OUTPUT_BYTES=16777216
#EVELAND_DEPLOYMENT_PORT=41000
#EVELAND_GIT_CLONE_TIMEOUT_MS=120000
#EVELAND_GIT_CLONE_MAX_ATTEMPTS=3
#EVELAND_GIT_CLONE_RETRY_DELAY_MS=1000
#WORKER_JOB_HEARTBEAT_INTERVAL_MS=30000
#WORKER_JOB_STALE_MS=120000
#WORKER_JOB_RECOVERY_BATCH_SIZE=25
#EVELAND_HEALTH_TIMEOUT_MS=15000
#EVELAND_HOST_METRIC_INTERVAL_MS=60000
#EVELAND_RELEASE_RETENTION=3
#EVELAND_RELEASE_SWEEP_INTERVAL_MS=3600000
#EVELAND_RELEASE_SWEEP_BATCH_SIZE=25
# Legacy per-project world retention; shared-world maintenance belongs to the dispatcher.
#EVELAND_WORKFLOW_SWEEP_INTERVAL_MS=3600000
#EVELAND_WORKFLOW_STREAM_RETENTION_MS=86400000
#EVELAND_WORKFLOW_SWEEP_BATCH_SIZE=50000
#EVELAND_SANDBOX_CACHE_DIR=/var/lib/eveland/sandbox
