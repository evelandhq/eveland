# Explicit here for clarity, though redundant with NODE_ENV=production below: since
# the systemd default flip, a production worker (NODE_ENV=production) resolves to
# systemd on its own when EVELAND_RUNTIME is unset. Keep it set explicitly anyway so
# this file documents the host's runtime unambiguously regardless of NODE_ENV.
EVELAND_RUNTIME=systemd
NODE_ENV=production
EVELAND_RELEASE_CHANNEL=stable
EVELAND_REVISION=unknown
EVELAND_DATA_DIR=/var/lib/eveland
# After preflight, Worker publishes only an already-masked configuration snapshot
# at /var/lib/eveland/diagnostics/worker-configuration.json for the admin About page.
# Native systemd worker and API share this same observer root through EVELAND_DATA_DIR.
# EVELAND_HOST_DATA_DIR is intentionally unnecessary here.
DATABASE_URL=postgres://eveland:eveland@127.0.0.1:5432/eveland
WORKFLOW_POSTGRES_URL=postgres://eveland:eveland@127.0.0.1:5432/eveland
# Must match the API's APP_SECRET_KEY (32 bytes); deploys fail at secret-decrypt time on mismatch.
APP_SECRET_KEY=change-me-to-a-32-byte-secret-00
EVELAND_AGENT_BASE_DOMAINS=agents.example.com
EVELAND_GATEWAY_INTERNAL_URL=http://127.0.0.1:4080
EVELAND_GATEWAY_SERVICE_TOKEN=change-me-to-a-long-random-gateway-secret
EVELAND_SCHEDULER_RUNTIME_SECRET=change-me-to-an-independent-random-runtime-secret
EVELAND_SCHEDULER_DISPATCH_SECRET=change-me-to-an-independent-random-dispatch-secret
EVELAND_SCHEDULER_REDEEM_URL=http://127.0.0.1:4000/internal/scheduler/dispatch
EVELAND_SCHEDULER_PLANNER_BATCH_SIZE=25
EVELAND_SCHEDULER_DISPATCH_TIMEOUT_MS=120000
EVELAND_SCHEDULER_PREWARM_MS=60000
EVELAND_ACTIVATION_IDLE_TTL_MS=300000
EVELAND_ACTIVATION_REAPER_BATCH_SIZE=25
EVELAND_ACTIVATION_RECOVERY_BATCH_SIZE=25
EVELAND_ACTIVATION_START_STALE_MS=300000
EVELAND_ACTIVATION_RECONCILE_BATCH_SIZE=100
# Optional overrides (defaults shown):
#EVELAND_BUILD_USER=eveland-build
#EVELAND_APP_USER=eveland-app
#EVELAND_BUILD_SANDBOX=bwrap
#EVELAND_MEMORY_MAX=2G
#EVELAND_CPU_QUOTA=200%
#EVELAND_DEPLOYMENT_PORT=41000
#EVELAND_GIT_CLONE_TIMEOUT_MS=120000
#EVELAND_GIT_CLONE_MAX_ATTEMPTS=3
#EVELAND_GIT_CLONE_RETRY_DELAY_MS=1000
#WORKER_JOB_HEARTBEAT_INTERVAL_MS=30000
#WORKER_JOB_STALE_MS=120000
#WORKER_JOB_RECOVERY_BATCH_SIZE=25
#EVELAND_HEALTH_TIMEOUT_MS=15000
#EVELAND_RELEASE_RETENTION=3
#EVELAND_SANDBOX_CACHE_DIR=/var/lib/eveland/sandbox
