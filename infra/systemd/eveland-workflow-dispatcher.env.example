NODE_ENV=production
EVELAND_RELEASE_CHANNEL=stable
EVELAND_REVISION=unknown

# The shared workflow database. Must be the same value the Worker injects into
# deployments, or the dispatcher will claim from a database nothing writes to.
EVELAND_WORKFLOW_WORLD_URL=postgres://eveland:eveland@127.0.0.1:17310/eveland_workflow
# Host-reachable URL for the same shared database when deployments reach
# Postgres by a different name than the platform's own processes do (e.g.
# host.docker.internal under Docker Desktop). Defaults to the URL above.
#EVELAND_WORKFLOW_WORLD_BOOTSTRAP_URL=postgres://eveland:eveland@127.0.0.1:17310/eveland_workflow
# Must match the Worker's value so write-side and terminal-rewrite compaction
# follow the same emergency-switch policy.
EVELAND_WORKFLOW_STREAM_COMPACTION=on

# Control API, for runtime activation. The dispatcher never reaches into Worker
# internals — waking a deployment goes through this API exactly as the Agent Gateway's
# cold start does.
WORKFLOW_DISPATCHER_ACTIVATION_API_URL=http://127.0.0.1:17301
# Must match the API's value; this is what authenticates /internal/* calls.
WORKFLOW_DISPATCHER_ACTIVATION_TOKEN=change-me-to-the-internal-service-token
# Must match the Worker's value: it is injected into every deployment, and the
# deployment's workflow world uses it to authenticate inbound dispatch.
EVELAND_SCHEDULER_RUNTIME_SECRET=change-me-to-the-runtime-secret

EVELAND_OTLP_ENDPOINT=http://127.0.0.1:17312
EVELAND_OTLP_SERVICE_TOKEN=change-me-to-the-collector-platform-receiver-secret
EVELAND_OTEL_METRIC_INTERVAL_MS=60000

# Tuning. The defaults suit a single host; raise the in-flight cap only after
# checking the workflow database's connection budget. The full knob list shares
# the WORKFLOW_DISPATCHER_* prefix and is documented in the
# @evelandhq/workflow-world README.
# WORKFLOW_DISPATCHER_CONCURRENCY=8
# WORKFLOW_DISPATCHER_POOL_SIZE=10
# WORKFLOW_DISPATCHER_MAX_INFLIGHT_PER_TENANT=8
# A step is unbounded in principle (model calls); this is a backstop against a
# wedged executor, not a service-level deadline.
# WORKFLOW_DISPATCHER_DISPATCH_TIMEOUT_MS=900000
# Must stay well under the API's EVELAND_ACTIVATION_LEASE_TTL_MS (180000), or a
# step longer than the lease loses its executor mid-flight. The dispatcher
# refuses to start if this is set at or above the TTL.
# WORKFLOW_DISPATCHER_LEASE_RENEW_INTERVAL_MS=60000
# Reclaims empty per-run Graphile queue rows.
# WORKFLOW_DISPATCHER_QUEUE_GC_INTERVAL_MS=300000
# Bounded workflow-world 0.7 storage maintenance. Zero disables the automatic
# maintenance loop; leave compaction/retention enabled to bound shared storage.
# WORKFLOW_DISPATCHER_MAINTENANCE_INTERVAL_MS=60000
# WORKFLOW_DISPATCHER_MAINTENANCE_STREAM_BATCH_SIZE=50000
# WORKFLOW_DISPATCHER_MAINTENANCE_MAX_BATCHES=20
# WORKFLOW_DISPATCHER_MAINTENANCE_MAX_STREAMS_TO_PACK=100
# WORKFLOW_DISPATCHER_MAINTENANCE_RUN_BATCH_SIZE=1000

# --- Registration heartbeat ---
# The dispatcher reports a machine-readable registration (state, ownership,
# boot recovery, World identity, protocol window) to the Control API; that
# registration — never systemd "active" or the stdout token — is what
# production deploys and workflow-step activation gate on.
#EVELAND_WORKFLOW_DISPATCHER_HEARTBEAT_INTERVAL_MS=15000
